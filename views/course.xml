<odoo>
    <data>

        <!-- List View -->
        <record id="view_course_list" model="ir.ui.view">
            <field name="name">Course</field>
            <field name="model">academic.course</field>
            <field name="type">list</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="responsible_id"/>
                    <field name="catatan"/>
                </list>
            </field>
        </record>


        <!-- Form View -->
        <record id="view_course_form" model="ir.ui.view">
            <field name="name">Course Form</field>
            <field name="model">academic.course</field>
            <field name="type">form</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <div class="oe_title">
                            <label for="name" class="oe_edit_only"/>
                            <h1>
                                <field name="name"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="responsible_id"/>
                            </group>
                            <group>
                                <field name="catatan"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Details">
                                <field name="description"/>
                            </page>
                            <page string="Sessions">
                                <field name="session_ids"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_course" model="ir.actions.act_window">
            <field name="name">Courses</field>
            <field name="res_model">academic.course</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Add a new course
                </p><p>
                    Click the create button to enter a new course.
                </p>
            </field>
        </record>

    </data>
</odoo>