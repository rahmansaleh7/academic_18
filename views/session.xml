<odoo>
    <data>

        <!-- List View -->
        <record id="view_session_list" model="ir.ui.view">
            <field name="name">Session</field>
            <field name="model">academic.session</field>
            <field name="type">list</field>
            <field name="arch" type="xml">
                <list decoration-info="duration &lt; 5" decoration-danger="duration &gt; 15">
                    <field name="name"/>
                    <field name="course_id"/>
                    <field name="instructor_id"/>
                    <field name="start_date"/>
                    <field name="duration"/>
                    <field name="seats"/>
                    <field name="end_date"/>
                    <field name="taken_seats" widget="progressbar"/>
                    <field name="state" widget="badge"
                           decoration-info="state == 'draft'"
                           decoration-warning="state == 'confirmed'"
                           decoration-success="state == 'done'"/>
                </list>
            </field>
        </record>


        <!-- Form View -->
        <record id="view_session_form" model="ir.ui.view">
            <field name="name">Session Form</field>
            <field name="model">academic.session</field>
            <field name="type">form</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="action_confirm" type="object"
                                string="Confirm" class="btn-primary"
                                invisible="state != 'draft'"/>
                        <button name="action_done" type="object"
                                string="Done" class="btn-primary"
                                invisible="state != 'confirmed'"/>
                        <button name="action_draft" type="object"
                                string="Reset to Draft"
                                invisible="state == 'draft'"/>
                        <field name="state" widget="statusbar"
                               statusbar_visible="draft,confirmed,done"/>
                    </header>
                    <sheet>
                        <field name="image" widget="image" class="oe_avatar"/>
                        <div class="oe_title">
                            <label for="name" class="oe_edit_only" string="Name"/>
                            <h1>
                                <field name="name"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="course_id"/>
                                <field name="instructor_id" domain="[('is_instructor', '=', True)]"/>
                                <field name="end_date"/>
                            </group>
                            <group>
                                <field name="start_date"/>
                                <field name="duration"/>
                                <field name="seats"/>
                                <field name="taken_seats" widget="progressbar"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Attendees">
                                <field name="attendee_ids">
                                    <list editable="bottom">
                                        <field name="partner_id"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Calendar View -->
        <record id="view_session_calendar" model="ir.ui.view">
            <field name="name">Session Calendar</field>
            <field name="model">academic.session</field>
            <field name="type">calendar</field>
            <field name="arch" type="xml">
                <calendar string="Session Calendar" date_start="start_date"
                            date_stop="end_date" color="instructor_id"
                            mode="month">
                    <field name="name"/>
                    <field name="course_id"/>
                    <field name="instructor_id"/>
                    <field name="start_date"/>
                    <field name="duration"/>
                    <field name="seats"/>
                    <field name="taken_seats"/>
                </calendar>
            </field>
        </record>

        <!-- Search View -->
        <record id="view_session_search" model="ir.ui.view">
            <field name="name">Session Search</field>
            <field name="model">academic.session</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="course_id"/>
                    <field name="instructor_id"/>
                    <filter name="my_courses" string="My Courses"
                            domain="[('course_id.responsible_id', '=', uid)]"/>
                    <separator/>
                    <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                    <filter name="confirmed" string="Confirmed" domain="[('state', '=', 'confirmed')]"/>
                    <filter name="done" string="Done" domain="[('state', '=', 'done')]"/>
                    <separator/>
                    <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                    <group expand="0" string="Group By">
                        <filter name="by_course" string="Course"
                                context="{'group_by': 'course_id'}"/>
                        <filter name="by_instructor" string="Instructor"
                                context="{'group_by': 'instructor_id'}"/>
                        <filter name="by_state" string="Status"
                                context="{'group_by': 'state'}"/>
                        <filter name="by_date" string="Start Date"
                                context="{'group_by': 'start_date'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Graph View -->
        <record id="view_session_graph" model="ir.ui.view">
            <field name="name">Session Graph</field>
            <field name="model">academic.session</field>
            <field name="arch" type="xml">
                <graph type="bar">
                    <field name="course_id"/>
                    <field name="taken_seats" type="measure"/>
                </graph>
            </field>
        </record>

        <!-- Pivot View -->
        <record id="view_session_pivot" model="ir.ui.view">
            <field name="name">Session Pivot</field>
            <field name="model">academic.session</field>
            <field name="arch" type="xml">
                <pivot>
                    <field name="course_id" type="row"/>
                    <field name="start_date" interval="month" type="col"/>
                    <field name="seats" type="measure"/>
                </pivot>
            </field>
        </record>

        <!-- Kanban View -->
        <record id="view_session_kanban" model="ir.ui.view">
            <field name="name">Session Kanban</field>
            <field name="model">academic.session</field>
            <field name="arch" type="xml">
                <kanban default_group_by="course_id">
                    <templates>
                        <t t-name="card">
                            <field name="image" widget="image"
                                   options="{'size': [64, 64]}"/>
                            <field name="name" class="fw-bold fs-5"/>
                            <field name="instructor_id"/>
                            <field name="taken_seats" widget="progressbar"/>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <record id="action_session" model="ir.actions.act_window">
            <field name="name">Sessions</field>
            <field name="res_model">academic.session</field>
            <field name="view_mode">list,form,calendar,graph,pivot,kanban</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Add a new session
                </p><p>
                    Click the create button to enter a new session.
                </p>
            </field>
        </record>

    </data>
</odoo>
