<odoo>
    <data>

        <record id="module_category_academic" model="ir.module.category">
            <field name="name">Academic</field>
        </record>

        <record id="group_user" model="res.groups">
            <field name="name">User</field>
            <field name="category_id" ref="module_category_academic"/>
        </record>

        <record id="group_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="category_id" ref="module_category_academic"/>
            <field name="implied_ids" eval="[(4, ref('group_user'))]"/>
            <field name="users" eval="[(4, ref('base.user_admin'))]"/>
        </record>

        <!-- perm_read False: semua tetap bisa melihat, -->
        <!-- aturan hanya berlaku untuk write/create/unlink -->
        <record id="rule_course_responsible" model="ir.rule">
            <field name="name">Course: responsible only</field>
            <field name="model_id" ref="model_academic_course"/>
            <field name="groups" eval="[(4, ref('group_user'))]"/>
            <field name="domain_force">['|',
                ('responsible_id', '=', False),
                ('responsible_id', '=', user.id)]</field>
            <field name="perm_read" eval="False"/>
        </record>

        <!-- Manager mewarisi group_user, jadi perlu rule sendiri agar bisa ubah semua Course -->
        <record id="rule_course_manager" model="ir.rule">
            <field name="name">Course: manager all</field>
            <field name="model_id" ref="model_academic_course"/>
            <field name="groups" eval="[(4, ref('group_manager'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="False"/>
        </record>

    </data>
</odoo>
