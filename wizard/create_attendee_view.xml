<odoo>
    <data>

        <!-- Form View -->
        <record id="view_academic_wizard_form" model="ir.ui.view">
            <field name="name">academic.wizard.form</field>
            <field name="model">academic.wizard</field>
            <field name="arch" type="xml">
                <form string="Add Attendees">
                    <group>
                        <field name="session_ids" widget="many2many_tags"/>
                        <field name="partner_ids" widget="many2many_tags"/>
                    </group>
                    <footer>
                        <button name="action_add_attendee" type="object"
                                string="Add" class="btn-primary"/>
                        <button string="Cancel" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_wizard" model="ir.actions.act_window">
            <field name="name">Add Attendees</field>
            <field name="res_model">academic.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="binding_model_id" ref="model_academic_session"/>
            <field name="binding_view_types">list,form</field>
        </record>

    </data>
</odoo>
